# Образ для работы агента в изоляции. Основание — docs/THREAT-MODEL.md
#
# Что здесь важно: непривилегированный пользователь, ничего лишнего в образе
# и предустановленный jq — без него замки блокируют команды, и это правильное
# поведение, но работать в таком окружении нельзя.

FROM docker.io/library/debian:12-slim

ARG UID=1000
ARG GID=1000

# Минимум для работы замков и гейтов: разбор JSON, git, python.
# Всё, что нужно конкретному стеку, добавляйте здесь же — установка пакетов
# во время работы агента означает, что окружение меняется под задачу.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq python3 python3-venv \
        build-essential less \
    && rm -rf /var/lib/apt/lists/*

# Пользователь с идентификаторами хоста: файлы, созданные внутри, остаются
# своими снаружи.
RUN groupadd -g "${GID}" dev 2>/dev/null || true \
    && useradd -m -u "${UID}" -g "${GID}" -s /bin/bash dev 2>/dev/null || true

USER dev
WORKDIR /work

# Проверка при старте: без jq замки блокируют всё подряд, и человек должен
# узнать причину сразу, а не через полчаса работы.
RUN command -v jq >/dev/null || (echo "jq обязателен — замки без него блокируют команды" && exit 1)

CMD ["bash"]
