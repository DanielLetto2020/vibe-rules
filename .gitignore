# Инструкции для агента — личные, в публичный репозиторий не уходят.
# Якорь на корень обязателен: без ведущего слэша правило скрыло бы и
# templates/project/CLAUDE.md, который как раз должен публиковаться.
/CLAUDE.md
/CLAUDE.local.md
/.claude/settings.local.json

# Локальный список названий внутренних систем для стража утечек.
# Сами названия приватны — в публичном репозитории их нет даже
# в списке запрещённых. Образец: tests/private-patterns.example
/tests/.private-patterns

# Дополнения к словарю секретов и исключения из него — проектные и приватные:
# внутренние префиксы токенов и имена систем публиковать нельзя, а список
# разрешённых находок специфичен для конкретного репозитория.
.claude/secret-patterns
**/.claude/secret-patterns
.claude/secret-allow
**/.claude/secret-allow

# Тестовые проекты. Лежат уровнем выше (../sandbox/), но правило есть и здесь:
# если песочницу однажды создадут внутри репозитория, она не уедет в публикацию.
/sandbox/
**/sandbox/

# Журналы фактических загрузок инструкций (пишет хук InstructionsLoaded)
.std-trace.jsonl
**/.std-trace.jsonl

# Отметка успешного прогона гейтов — локальное состояние машины
.gauntlet-pass
**/.gauntlet-pass

*.tmp
.DS_Store
